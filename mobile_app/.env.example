# URL of the chat widget served from ../web_widget (npm run dev).
#
# Pick the right host for where you run the app:
#   Web / iOS simulator ....... http://localhost:5173
#   Android emulator .......... http://10.0.2.2:5173
#   Physical phone (Expo Go) .. http://<your-computer-LAN-IP>:5173
#
# Anything prefixed with EXPO_PUBLIC_ is inlined at build time, so restart the
# dev server with `npx expo start -c` after changing this.
EXPO_PUBLIC_WIDGET_URL=http://localhost:5173

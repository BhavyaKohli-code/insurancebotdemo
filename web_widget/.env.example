# Port the widget dev server listens on. Keep this in sync with
# EXPO_PUBLIC_WIDGET_URL in ../mobile_app/.env
PORT=5173

# Branding shown inside the chat header
VITE_BOT_NAME=ABC Assist
VITE_COMPANY_NAME=ABC Insurance Ltd.

# Backend for real answers. Left empty on purpose: while this is empty the
# widget replies with built-in canned answers and costs nothing.
VITE_API_BASE_URL=

# Public hostname when serving through a tunnel, e.g.
# PUBLIC_HOST=bec8-119-252-218-48.ngrok-free.app
# Leave empty for plain localhost / LAN use. Only affects hot reload.
PUBLIC_HOST=
